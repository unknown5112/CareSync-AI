# CareSync AI - Environment Variable Template

# Application Environment
APP_ENV=production
DEBUG=false
TEST_MODE=false
PORT=8000

# Google Gemini API (Required for OCR and Drug Interaction Analysis)
GEMINI_API_KEY=your_gemini_api_key_here

# Supabase Credentials (Required for Adherence DB & Auth)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here

# SMTP Email Configuration (For Automated Medication Reminders & Caregiver Alerts)
EMAIL_SENDER=caresync.notifications@gmail.com
EMAIL_PASSWORD=your_app_specific_password_here
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
